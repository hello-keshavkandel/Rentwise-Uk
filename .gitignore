# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Data — do NOT commit large raw files to GitHub.
# Keep the folder (via .gitkeep) but ignore the downloaded files.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/rentwise.duckdb
# The DuckDB store is the app's primary data source — committed and deployed.
!
# Models (large binaries)
models/*.pkl
models/*.joblib
!models/.gitkeep

