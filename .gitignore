# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Data — do NOT commit large raw files to GitHub.
# Keep the folder (via .gitkeep) but ignore the downloaded files.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/processed/rentwise.duckdb
# Prepared (WGS84, England & Wales) LA boundaries for the app's maps — small, committed.
!data/processed/lad_boundaries_wgs84.geojson
!data/processed/school_quality_by_la.csv
!data/processed/osm_amenities_by_la.csv
!data/processed/la_spatial_features.csv
# The DuckDB store is the app's primary data source — committed and deployed.
!
# Models (large binaries)
models/*.pkl
models/*.joblib
!models/.gitkeep

# OS
.DS_Store

# secrets
.env
data/raw/epc/*
!data/raw/epc/.gitkeep

# generated interactive maps (rebuild with src.viz.maps)
reports/maps/

# API database (users, keys, alerts) — runtime data, never committed
data/api/
*.sqlite3
