# RentWise UK — environment variables. Copy to .env (make setup does this); never commit .env.

# --- Public API (Milestone 5) ---------------------------------------------
# Where accounts, API keys, saved areas, alerts and notifications are stored.
RENTWISE_API_DB=data/api/rentwise_api.sqlite3
# Requests per minute per API key.
RENTWISE_RATE_LIMIT=60
# 1 = anyone can sign up; 0 = sign-up disabled.
RENTWISE_ALLOW_SIGNUP=1
# Login token lifetime in days.
RENTWISE_SESSION_DAYS=7

# --- Alert email delivery (optional; without these, alerts are stored and logged) ---
RENTWISE_SMTP_HOST=
RENTWISE_SMTP_PORT=587
RENTWISE_SMTP_USER=
RENTWISE_SMTP_PASSWORD=
RENTWISE_SMTP_FROM=alerts@rentwise.local

# --- EPC Open Data (only for rebuilding Module 1) -------------------------
# Legacy Open Data Communities API; not verified against the new GOV.UK service.
# Prefer the bulk download: https://get-energy-performance-data.communities.gov.uk
EPC_EMAIL=
EPC_API_KEY=
