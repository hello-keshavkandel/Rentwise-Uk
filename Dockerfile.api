# RentWise UK — public REST API container (Milestone 5)
# Build:  docker build -f Dockerfile.api -t rentwise-api .
# Run:    docker run -p 8000:8000 -v rentwise-api-data:/app/data/api rentwise-api   -> http://localhost:8000/docs
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    RENTWISE_API_DB=/app/data/api/rentwise_api.sqlite3

WORKDIR /app
COPY requirements.txt requirements-api.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt -r requirements-api.txt

COPY . .
# run as an unprivileged user; only the API database directory is writable
RUN useradd --create-home --uid 10001 rentwise && mkdir -p /app/data/api && chown -R rentwise /app/data/api
USER rentwise

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/v1/health', timeout=5).status == 200 else 1)"

CMD ["uvicorn", "src.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
